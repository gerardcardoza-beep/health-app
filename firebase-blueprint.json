{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, email, display name, and linked clinical identifier",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor"] },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "PatientNote": {
      "title": "PatientNote",
      "description": "Secure persistent personal clinical notes or memo saved by the patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "patientId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "patientId", "title", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles partitioned by Firebase Auth UID"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/PatientNote" },
      "description": "Private user health notes and personal bookmarks"
    }
  }
}
